# JARVIS configuration. Copy to .env and edit. Real environment variables
# always override values in this file.

## Brain
# auto = use Ollama if reachable, otherwise fall back to extractive
# (retrieval-only, no LLM — the mode that runs standalone on a Pi Zero 2W).
# options: auto, ollama, extractive, test
JARVIS_BACKEND=auto

# Ollama server. On a Pi Zero 2W, point this at a Pi 5 / desktop on your
# LAN that runs `ollama serve` — still fully offline, no cloud involved.
OLLAMA_ENDPOINT=http://localhost:11434
# Small models that support tool calling: qwen2.5:1.5b (default),
# qwen2.5:3b, llama3.2:3b. Pull with: ollama pull <model>
JARVIS_CHAT_MODEL=qwen2.5:1.5b
# Show model reasoning while it thinks (only for models that support it)
ENABLE_THINKING=false
# Let the LLM call tools (search_knowledge / read_skill / remember / time)
ENABLE_TOOLS=true
MAX_TOOL_ROUNDS=4

## Training / RAG
# auto = use Ollama embeddings (nomic-embed-text) when reachable, else the
# built-in dependency-free local embedder (works on a Pi Zero 2W).
# options: auto, ollama, local
JARVIS_EMBED_BACKEND=auto
JARVIS_EMBED_MODEL=nomic-embed-text
RAG_ENABLED=true
RAG_TOP_K=3
# Results below this cosine score are treated as "no relevant knowledge".
# Unset = adaptive default: 0.55 for ollama embeddings, 0.18 for the local
# embedder (its keyword-based scores run much lower than semantic scores).
# RAG_SCORE_THRESHOLD=0.55
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80

## Conversation
# Start a fresh conversation after this many idle seconds
CHAT_HISTORY_RESET_SEC=300
# Persona (a speech-friendly no-Markdown instruction is always appended)
# SYSTEM_PROMPT="You are JARVIS, a witty but precise assistant."

## Memory
MEMORY_ENABLED=true
MEMORY_MAX_INJECT=10

## Voice mode (jarvis voice) — optional, for Raspberry Pi (+ Whisplay HAT)
# ASR options: auto, vosk, whisper-http, none
ASR_BACKEND=auto
# VOSK_MODEL_PATH=/home/pi/vosk-model-small-en-us-0.15
# WHISPER_HTTP_URL=http://localhost:8804
# TTS options: auto, espeak-ng, piper, none
TTS_BACKEND=auto
# PIPER_BINARY_PATH=/home/pi/piper/piper
# PIPER_MODEL_PATH=/home/pi/piper/en_US-amy-medium.onnx
# ESPEAK_NG_VOICE=en
# ESPEAK_NG_SPEED=175
# ALSA_INPUT_DEVICE=
# ALSA_OUTPUT_DEVICE=
RECORD_MAX_SEC=30
# Where the Whisplay driver repo lives. Auto-detected: ~/Whisplay/runtime
# first (standard install on the device), then copies next to this project.
# WHISPLAY_DRIVER_DIR=/home/pi/Whisplay/runtime

## Emotions (animated faces on the LCD)
# Face style: "emo" (default — big glowing eyes on black, EMO-robot style)
# or "classic" (round yellow smiley faces)
# JARVIS_FACE_STYLE=emo
# Emo face size inside its rounded screen box (0.4-1.0).
# Default 0.75 = small face in a bezel box; 1.0 = full-screen face, no box.
# JARVIS_FACE_SCALE=0.75
# Folder for custom emotion GIF overrides (see emotions/README.md)
# JARVIS_EMOTIONS_DIR=./emotions

## Debug console (jarvis debug)
# Web dashboard for developing JARVIS: chat tester, pipeline trace with
# RAG scores and tool calls, RAG inspector, emotion previews.
# Set host to 0.0.0.0 to open it from another machine (e.g. Pi on your LAN).
# JARVIS_DEBUG_HOST=127.0.0.1
# JARVIS_DEBUG_PORT=17870
